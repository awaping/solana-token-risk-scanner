{
  "name": "solana-token-risk-scanner",
  "version": "1.0.0",
  "description": "Scanner open-source de risques et de liquidité pour tokens Solana (bonding curves Pump.fun, PumpSwap, Raydium) : distribution des holders, clustering de wallets, dusting, réserve réelle, traçabilité du créateur et score de risque 0-100.",
  "type": "module",
  "bin": {
    "sol-risk": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "scan": "tsx src/index.ts",
    "demo": "tsx scripts/demo.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "keywords": [
    "solana",
    "pump.fun",
    "pumpswap",
    "raydium",
    "bonding-curve",
    "rug-pull",
    "security",
    "risk-scoring",
    "spl-token",
    "web3"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awaping/solana-token-risk-scanner.git"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bignumber.js": "^9.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
