# ============================================================================
#  MemeticSniper — configuration
#  cp .env.example .env   puis remplir. Ne JAMAIS committer .env.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. RUNTIME
# ---------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info                      # trace|debug|info|warn|error
# true = tout est construit et simulé, rien n'est envoyé on-chain. GARDER true
# tant que la chaîne complete n'a pas ete validee sur devnet.
DRY_RUN=true

# ---------------------------------------------------------------------------
# 2. LISTENER TWITTER/X
#    Le "filtered stream" officiel exige un plan Pro. Choisir un MODE :
#      api  -> twitter-api-v2 filtered stream (TWITTER_BEARER_TOKEN requis)
#      ws   -> relais WebSocket tiers (latence generalement meilleure)
#      poll -> polling REST (fallback, latence 2-15s, non competitif)
# ---------------------------------------------------------------------------
LISTENER_MODE=ws
TWITTER_BEARER_TOKEN=
# Relais WS tiers (ex. TweetScout / Apify actor / feed prive)
TWITTER_WS_URL=wss://example-relay.invalid/stream
TWITTER_WS_API_KEY=
# Whitelist: user IDs numeriques (pas les @handles — un handle peut etre
# renomme et re-enregistre par un tiers, l'ID est immuable).
WHITELIST_USER_IDS=44196397,1234567890
# Ignorer retweets / replies / quotes (bruit et signaux derives)
IGNORE_RETWEETS=true
IGNORE_REPLIES=true
# Age maximum d'un tweet encore jouable (ms). Au-dela on jette.
MAX_TWEET_AGE_MS=15000
# Concurrence du pipeline d'analyse
ANALYZER_CONCURRENCY=4

# ---------------------------------------------------------------------------
# 3. REDIS (deduplication tweet_id + locks de deploiement)
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=msniper:
# TTL du marqueur de deduplication d'un tweet (s)
DEDUPE_TTL_SECONDS=86400
# TTL du lock global "un deploiement a la fois" (s)
DEPLOY_LOCK_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# 4. LLM — filtre semantique
#    Endpoint OpenAI-compatible. Groq ou Gemini, au choix :
#      Groq   : https://api.groq.com/openai/v1
#      Gemini : https://generativelanguage.googleapis.com/v1beta/openai
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Modele texte (rapide)
LLM_MODEL=llama-3.3-70b-versatile
# Modele multimodal, utilise seulement si le tweet contient des images.
# Groq   : meta-llama/llama-4-scout-17b-16e-instruct
# Gemini : gemini-1.5-flash
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
LLM_TIMEOUT_MS=2500
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.4
# Seuil de confiance en dessous duquel on ne deploie pas [0..1]
MIN_CONFIDENCE=0.72
# Mots/marques interdits dans name+symbol, separes par des virgules
NAME_BLOCKLIST=nazi,hitler,isis,cp,rape

# ---------------------------------------------------------------------------
# 5. GENERATION D'IMAGE (Fal.ai — Flux Schnell)
# ---------------------------------------------------------------------------
FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell
FAL_IMAGE_SIZE=square
FAL_NUM_INFERENCE_STEPS=4
FAL_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# 6. STOCKAGE METADONNEES (Irys / Arweave)
#    Fallback: l'API pump.fun (https://pump.fun/api/ipfs) si Irys echoue.
# ---------------------------------------------------------------------------
IRYS_NETWORK=mainnet
IRYS_RPC_URL=https://api.mainnet-beta.solana.com
# Cle payeuse Irys (base58). Peut etre distincte du wallet de trading.
IRYS_PRIVATE_KEY=
IRYS_TIMEOUT_MS=8000
METADATA_FALLBACK_URL=https://pump.fun/api/ipfs

# ---------------------------------------------------------------------------
# 7. SOLANA
# ---------------------------------------------------------------------------
# RPC prive a faible latence obligatoire (Helius/Triton/QuickNode).
# L'endpoint public api.mainnet-beta est rate-limite et inutilisable en HFT.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME
RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=REPLACE_ME
COMMITMENT=processed

# Wallet payeur / deployeur (base58, format Phantom export)
DEPLOYER_PRIVATE_KEY=
# Wallets de snipe additionnels (base58, separes par des virgules).
# Permet de repartir l'achat initial sur plusieurs adresses dans le bundle.
SNIPER_PRIVATE_KEYS=

# Programme Pump.fun (verifier contre l'IDL live avant mainnet)
PUMP_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
# Le fee_recipient et le bareme de frais NE sont PAS configurables ici : ils
# sont relus du compte global on-chain au boot (fetchGlobal). Tout hardcode
# devient faux en quelques semaines.

# Taille de l'achat initial, en SOL, par wallet sniper
INITIAL_BUY_SOL=0.15
# Tolerance de slippage sur le buy atomique (bps). 500 = 5%
SLIPPAGE_BPS=500
# Compute budget
COMPUTE_UNIT_LIMIT=350000
COMPUTE_UNIT_PRICE_MICROLAMPORTS=150000

# Pool de keypairs de mint pre-generes en memoire (economise le CPU au moment T)
MINT_KEYPAIR_POOL_SIZE=25
# Suffixe vanity optionnel pour les mints (ex. "pump"). Vide = desactive :
# le grinding vanity coute des secondes de CPU et tue la latence.
MINT_VANITY_SUFFIX=

# ---------------------------------------------------------------------------
# 8. JITO (MEV / bundles atomiques)
# ---------------------------------------------------------------------------
# Regions ciblees, separees par des virgules. Le bundle est diffuse en
# parallele sur toutes; la premiere reponse gagne.
JITO_BLOCK_ENGINES=ny.mainnet.block-engine.jito.wtf,frankfurt.mainnet.block-engine.jito.wtf
# Endpoint HTTP pour getBundleStatuses / tip floor
JITO_HTTP_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_FLOOR_URL=https://bundles.jito.wtf/api/v1/bundles/tip_floor
# Keypair d'authentification searcher (base58). Optionnel depuis que Jito a
# ouvert l'acces sans auth; laisser vide si non whiteliste.
JITO_AUTH_PRIVATE_KEY=
# Tip. Si JITO_DYNAMIC_TIP=true, on lit le tip floor et on applique le
# percentile choisi, borne par MIN/MAX.
JITO_DYNAMIC_TIP=true
JITO_TIP_PERCENTILE=75            # 25|50|75|95|99
JITO_TIP_MIN_LAMPORTS=1000000     # 0.001 SOL
JITO_TIP_MAX_LAMPORTS=20000000    # 0.02 SOL
JITO_TIP_MULTIPLIER=1.3
# Attente max de confirmation d'un bundle (ms)
JITO_BUNDLE_TIMEOUT_MS=25000

# ---------------------------------------------------------------------------
# 9. TRADER (gestion de position post-lancement)
# ---------------------------------------------------------------------------
TAKE_PROFIT_MULTIPLIERS=2,5,10     # x par rapport au prix d'entree
TAKE_PROFIT_SELL_PCT=40,30,30      # % de la position vendue a chaque palier
STOP_LOSS_PCT=55                   # sortie si -55% vs entree
MAX_HOLD_SECONDS=900               # sortie forcee au dela
PRICE_POLL_INTERVAL_MS=400
TRAILING_STOP_PCT=25               # sortie si -25%% sous le sommet
TRAILING_ARMS_AT_MULTIPLE=2        # le trailing ne s'arme qu'au-dessus de 2x
VOLUME_DRY_UP_SECONDS=30           # sortie si les reserves ne bougent plus
SELL_SLIPPAGE_BPS=500              # slippage applique a min_sol_output
SELL_COMPUTE_UNIT_LIMIT=220000
SELL_COMPUTE_UNIT_PRICE_MICROLAMPORTS=120000
MIN_CLAIM_SOL=0.005                # seuil sous lequel un claim coute plus qu'il ne rapporte
AUTO_CLAIM_CREATOR_FEES=true
CLAIM_FEES_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# 10. GARDE-FOUS
# ---------------------------------------------------------------------------
# Plafond de depense cumulee sur 24h (SOL). Au-dela le bot s'arrete.
MAX_DAILY_SPEND_SOL=3
# Nombre max de deploiements par heure
MAX_DEPLOYS_PER_HOUR=4
# Solde minimum a conserver sur le deployeur (SOL, frais de rent + gas)
MIN_DEPLOYER_BALANCE_SOL=0.1

# ---------------------------------------------------------------------------
# 11. SIMULATION (scripts/simulateBundle.ts)
# ---------------------------------------------------------------------------
# false = payeur jetable, la simulation s'arrete au niveau transaction et ne
#         valide PAS la table de comptes (verdict "not-exercised").
# true  = signe la simulation avec DEPLOYER_PRIVATE_KEY. Reste en lecture
#         seule : rien n'est diffuse. Seul moyen d'exercer create+buy pour de
#         vrai contre le programme deploye.
USE_REAL_PAYER=false
