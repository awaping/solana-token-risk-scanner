# Endpoint RPC Solana (mainnet). L'endpoint public est fortement limité :
# pour une analyse complète (recensement des holders, historique du créateur),
# utilisez un RPC dédié (Helius, Triton, QuickNode, Alchemy...).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Nombre maximal de requêtes RPC simultanées.
RPC_CONCURRENCY=4

# Nombre de tentatives en cas d'erreur 429 / erreur réseau.
RPC_MAX_RETRIES=5

# Nombre de transactions récentes du créateur inspectées pour compter
# les tokens qu'il a déployés.
CREATOR_TX_SCAN_LIMIT=100

# Nombre maximal de pages (1000 signatures / page) parcourues pour retrouver
# la transaction de création du mint quand le créateur n'est pas connu.
MINT_HISTORY_MAX_PAGES=5

# Recensement complet des holders (getProgramAccounts) pour le dusting check.
# Mettre à false sur un RPC qui refuse getProgramAccounts sur le Token Program.
HOLDER_CENSUS=true
