# Endpoint RPC Solana (mainnet). L'endpoint public est fortement limité :
# pour une analyse complète (recensement des holders, historique du créateur),
# utilisez un RPC dédié (Helius, Triton, QuickNode, Alchemy...).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Nombre maximal de requêtes RPC simultanées.
RPC_CONCURRENCY=4

# Nombre de tentatives en cas d'erreur 429 / erreur réseau.
RPC_MAX_RETRIES=5

# Nombre de transactions récentes du créateur inspectées pour compter
# les tokens qu'il a déployés.
CREATOR_TX_SCAN_LIMIT=100

# Nombre maximal de pages (1000 signatures / page) parcourues pour retrouver
# la transaction de création du mint quand le créateur n'est pas connu.
MINT_HISTORY_MAX_PAGES=5

# Recensement complet des holders (getProgramAccounts) pour le dusting check.
# Mettre à false sur un RPC qui refuse getProgramAccounts sur le Token Program.
HOLDER_CENSUS=true

# --- Mode stream -------------------------------------------------------------
# Endpoint(s) WebSocket, séparés par des virgules pour les mettre en course.
# Par défaut : dérivé de SOLANA_RPC_URL (https:// → wss://).
# SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=XXX,wss://autre-fournisseur

# Source Yellowstone gRPC (la plus rapide), nécessite :
#   npm install @triton-one/yellowstone-grpc
# YELLOWSTONE_GRPC_URL=https://...
# YELLOWSTONE_GRPC_TOKEN=...

# Blockchain par défaut de `npm run stream` quand aucune n'est donnée en argument.
# STREAM_CHAIN=solana

# --- Mode stream sur les chaînes EVM (npm run stream robinhood, base, bsc…) -----
# Sans configuration, le RPC public de la chaîne est utilisé (limité, souvent
# sans WebSocket). Nom de variable : RPC_URL_<CLÉ> / WS_URL_<CLÉ>, clé en
# majuscules (liste des clés : npm run stream -- --chains).
# RPC_URL_BASE=https://base-mainnet.g.alchemy.com/v2/XXX
# WS_URL_BASE=wss://base-mainnet.g.alchemy.com/v2/XXX
# RPC_URL_ROBINHOOD=https://...
# WS_URL_ROBINHOOD=wss://...
# RPC_URL_BSC=https://...
# WS_URL_BSC=wss://fournisseur-a,wss://fournisseur-b
