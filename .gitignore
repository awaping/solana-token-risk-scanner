node_modules/
# Sortie de compilation du CLI, à la racine uniquement.
/dist/
# extension/dist/ est VERSIONNÉ à dessein : une extension se charge telle
# quelle dans Chrome, sans étape de build. L'exclure obligerait quiconque
# télécharge le dépôt à installer Node avant de pouvoir simplement la charger.
.env
*.log
coverage/
.DS_Store
.cache/

# Assistant de mise à jour de l’extension (généré par npm run setup:updater)
extension/updater/host.cmd
extension/updater/host.sh
extension/updater/host-manifest.json
