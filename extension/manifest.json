{
  "manifest_version": 3,
  "name": "Solana Token Risk Scanner",
  "version": "1.5.2",
  "key": "",
  "description": "Affiche le score de risque d'un token Solana (0 = sain, 100 = danger) par-dessus les terminaux memecoin.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://ipfs.io/*",
    "https://*.mypinata.cloud/*",
    "https://gateway.pinata.cloud/*",
    "https://cf-ipfs.com/*",
    "https://arweave.net/*",
    "https://frontend-api-v3.pump.fun/*",
    "https://metadata.j7tracker.io/*",
    "https://gateway.irys.xyz/*",
    "https://*.arweave.net/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Solana Token Risk Scanner",
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_start",
      "matches": [
        "https://pump.fun/*",
        "https://*.pump.fun/*",
        "https://trade.padre.gg/*",
        "https://*.padre.gg/*",
        "https://axiom.trade/*",
        "https://*.axiom.trade/*",
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*",
        "https://birdeye.so/*",
        "https://*.birdeye.so/*",
        "https://solscan.io/*",
        "https://dexscreener.com/*",
        "https://photon-sol.tinyastro.io/*",
        "https://neo.bullx.io/*",
        "https://bullx.io/*"
      ]
    }
  ]
}
