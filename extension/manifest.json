{
  "manifest_version": 3,
  "name": "Solana Token Risk Scanner",
  "version": "1.2.3",
  "description": "Affiche le score de risque d'un token Solana (0 = sain, 100 = danger) par-dessus les terminaux memecoin.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Solana Token Risk Scanner",
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle",
      "matches": [
        "https://pump.fun/*",
        "https://*.pump.fun/*",
        "https://trade.padre.gg/*",
        "https://*.padre.gg/*",
        "https://axiom.trade/*",
        "https://*.axiom.trade/*",
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*",
        "https://birdeye.so/*",
        "https://*.birdeye.so/*",
        "https://solscan.io/*",
        "https://dexscreener.com/*",
        "https://photon-sol.tinyastro.io/*",
        "https://neo.bullx.io/*",
        "https://bullx.io/*"
      ]
    }
  ]
}
